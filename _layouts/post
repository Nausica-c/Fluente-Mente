---
layout: default
---
<article class="card">
    <h1>{{ page.title }}</h1>
    
    <!-- Box In Breve (se definito nel file markdown) -->
    {% if page.in_breve %}
    <div class="in-breve">
        <strong>In breve:</strong> {{ page.in_breve }}
    </div>
    {% endif %}

    <div class="content">
        {{ content }}
    </div>
</article>

<a href="{{ site.baseurl }}/">← Torna alla home</a>
